# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Release signing credentials — never commit the real keystore.
android/key.properties

# Golden diff output, regenerated on every failing run.
test/failures/

# The training-time pipeline. The pinned commits and the export recipe are in
# git; the checkouts, the virtualenv and the model weights they produce are
# not. See vision/README.md.
vision/.vendor/
vision/.venv/
*.onnx
# The bundled quantised models are the exception: they ship in the app.
!android/app/src/main/assets/*.onnx
!ios/Runner/Models/*.onnx
*.pth

# CocoaPods fetches these from the Podfile.
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/ephemeral/

# Training checkpoints. Large binaries produced by the pinned recipe, and
# regenerated by tool/vision/setup.sh plus a download.
/work/

# Training artefacts: datasets, checkpoints, logs and evaluation output.
# The recipe is checked in; the several gigabytes it produces are not.
work/
build/vision/
.venv-train/
.vendor-train/
